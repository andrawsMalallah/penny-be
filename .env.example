# Local development only. Northflank values belong in its environment/secret settings.
# Generate a unique Django secret; never reuse the example file as production configuration.
PENNY_SECRET_KEY=
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve securely with backups.
PENNY_2FA_ENCRYPTION_KEY=
PENNY_LOCAL_HTTP=1
PENNY_ALLOWED_HOSTS=127.0.0.1,localhost
PENNY_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Dedicated LOCAL development database. Supply your actual local role/password.
PENNY_DB_HOST=127.0.0.1
PENNY_DB_PORT=5432
PENNY_DB_NAME=penny_web_dev
PENNY_DB_USER=penny_web_dev
PENNY_DB_PASSWORD=
PENNY_DB_SSLMODE=prefer

# Brevo SMTP credentials (the SMTP key is different from a Brevo API key).
PENNY_EMAIL_HOST=smtp-relay.brevo.com
PENNY_EMAIL_PORT=587
PENNY_EMAIL_USER=
PENNY_EMAIL_PASSWORD=
PENNY_EMAIL_FROM=
